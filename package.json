{
  "name": "cluely-studio",
  "version": "1.0.0",
  "description": "Production-grade desktop AI copilot with stealth screen-sharing protection and dual-channel audio capture",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron --external:sherpa-onnx-node && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "dev:renderer": "vite --port 5173 --strictPort",
    "dev": "npm run build:electron && concurrently -k \"npm run dev:renderer\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run build:electron && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/marked": "^5.0.2",
    "autoprefixer": "^10.6.1",
    "lucide-react": "^1.60.0",
    "marked": "^18.1.1",
    "postcss": "^8.5.31",
    "qrcode": "^1.5.4",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "esbuild": "^0.20.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  }
}
